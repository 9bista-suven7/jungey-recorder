{
  "name": "jungey-recorder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/icons.mjs && node scripts/dev.mjs",
    "build": "node scripts/icons.mjs && tsc --noEmit && vite build",
    "start": "npm run build && electron --no-sandbox .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "install-app": "npm run build && electron-builder --linux dir && sh scripts/install-linux.sh"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "devicon": "^2.18.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "fix-webm-duration": "^1.0.6",
    "lucide": "^1.61.0",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "description": "Make explainer videos: blackboard, webcam bubble, screen share and teleprompter in one desktop app",
  "author": "Jungey",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.jungey.recorder",
    "productName": "Jungey Recorder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "maintainer": "Jungey",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "extendInfo": {
        "NSCameraUsageDescription": "Jungey Recorder shows your camera in the video.",
        "NSMicrophoneUsageDescription": "Jungey Recorder records your voice."
      }
    },
    "win": {
      "target": "nsis"
    }
  }
}
